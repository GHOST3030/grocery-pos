# Copy to .env and fill in for LOCAL (offline) deployment
NODE_ENV=development
DEPLOY_MODE=local

PORT=5000

# Local PostgreSQL running on the same machine
DATABASE_URL=postgresql://postgres:password@localhost:5432/pos_db

JWT_SECRET=change-this-to-a-long-random-local-secret
JWT_EXPIRES_IN=12h

# Not internet-exposed, so CORS can stay open to localhost only
CORS_ORIGIN=http://localhost:5173
