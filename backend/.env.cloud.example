# Copy to .env and fill in for CLOUD (hosted) deployment
NODE_ENV=production
DEPLOY_MODE=cloud

PORT=5000

# Hosted PostgreSQL (Supabase/Render/Railway)
DATABASE_URL=postgresql://user:password@hosted-host:5432/pos_db?sslmode=require

JWT_SECRET=change-this-to-a-long-random-production-secret
JWT_EXPIRES_IN=2h

# Internet-exposed — lock CORS to the real frontend domain
CORS_ORIGIN=https://your-pos-frontend.example.com
